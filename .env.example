# Cấu hình Cổng máy chủ (Server Port)
PORT=3000
SESSION_SECRET=super_secret_session_key_bt_2026

# Địa chỉ URL gốc của ứng dụng (dùng cho OAuth Redirect callback)
APP_URL=http://localhost:3000

# -------------------------------------------------------------
# GOOGLE OAUTH 2.0 (GMAIL)
# Hướng dẫn tạo:
# 1. Truy cập https://console.cloud.google.com/apis/credentials
# 2. Tạo "OAuth 2.0 Client IDs" (Web application)
# 3. Thêm URI chuyển hướng được ủy quyền (Authorized redirect URI):
#    http://localhost:3000/auth/google/callback
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------------
# GITHUB OAUTH
# Hướng dẫn tạo:
# 1. Truy cập https://github.com/settings/developers
# 2. Tạo "New OAuth App"
# 3. Homepage URL: http://localhost:3000
# 4. Authorization callback URL: http://localhost:3000/auth/github/callback
# -------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
